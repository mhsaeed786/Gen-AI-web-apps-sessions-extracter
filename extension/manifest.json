{
  "manifest_version": 3,
  "name": "AI Session Extractor",
  "version": "1.0.1",
  "description": "Extract full conversations word-by-word from AI web apps (Gemini, ChatGPT, Claude, DeepSeek, Copilot, Grok, Kimi, Meta AI, MiniMax, Manus, Zai, Perplexity, Poe, Mistral, Qwen, Pi, Jules, and more).",
  "permissions": ["activeTab", "tabs", "storage", "downloads", "scripting", "contextMenus"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://copilot.microsoft.com/*",
        "https://grok.com/*",
        "https://x.com/i/grok*",
        "https://kimi.moonshot.cn/*",
        "https://www.kimi.com/*",
        "https://meta.ai/*",
        "https://hailuoai.com/*",
        "https://minimax.io/*",
        "https://agent.minimax.io/*",
        "https://manus.im/*",
        "https://manus.app/*",
        "https://chat.z.ai/*",
        "https://z.ai/*",
        "https://www.perplexity.ai/*",
        "https://poe.com/*",
        "https://chat.mistral.ai/*",
        "https://chatglm.cn/*",
        "https://tongyi.aliyun.com/*",
        "https://chat.qwen.ai/*",
        "https://coder.qwen.ai/*",
        "https://pi.ai/*",
        "https://jules.google.com/*",
        "https://you.com/*",
        "https://huggingface.co/chat*",
        "https://character.ai/*",
        "https://chat.reka.ai/*"
      ],
      "js": ["content.js"],
      "css": ["content-styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "sw.js"
  }
}
